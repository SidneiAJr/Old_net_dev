Type=Exe
' ============================================================
' Agenda.vbp - Visual Basic Project File
'
' Esse arquivo era gerado pelo IDE do VB6.
' Listava todos os arquivos do projeto, as referencias COM
' e as configuracoes de compilacao.
'
' "Compilar" no VB6 gerava um .EXE que ainda precisava das
' DLLs do VB6 Runtime na maquina. Distribuir um sistema VB6
' era uma aventura: tinha que mandar o setup com as DLLs certas
' ou a pessoa abria e levava "Component not registered".
' ============================================================

' Formularios do projeto
Form=frmLogin.frm
Form=frmAgenda.frm

' Modulo de codigo
Module=Module1; Module1.bas

' Ponto de entrada - qual form abre primeiro
Startup="frmLogin"

' Referencias COM - o "package.json" do VB6
' Sem essas DLLs registradas no Windows, nao rodava
' Cada linha era um componente COM que tinha que estar no Registry
Reference=*\G{00020430-0000-0000-C000-000000000046}#2.0#0#..\..\..\WINDOWS\system32\stdole2.tlb#OLE Automation
Reference=*\G{B691E011-1797-432E-907A-4D8C69339129}#6.0#0#..\..\..\Program Files\Common Files\System\ADO\msado15.dll#Microsoft ActiveX Data Objects 6.0 Library
' msado15.dll = ADO 6.0 - a DLL que conectava ao banco
' Precisava estar registrada: regsvr32 msado15.dll

' Componente do MSFlexGrid
Object={6B7E6392-850A-101B-AFC0-4210102A8DA7}#1.3#0; MSFLXGRD.OCX
' .OCX = ActiveX Control = o "npm install" do VB6
' Tinha que registrar o .OCX tambem: regsvr32 MSFLXGRD.OCX
' Se nao tivesse registrado: "Could not load an object because
'  it is not available on this machine" - o erro mais comum da historia

' Configuracoes do executavel
ExeName32="Agenda.exe"
Name="AgendaContatos"
HelpContextID="0"
CompatibleMode="0"
MajorVer=1
MinorVer=0
RevisionVer=0
AutoIncrementVer=0
CompilationType=0        ' 0 = P-Code, 1 = Native Code
' P-Code era interpretado pelo VB6 Runtime
' Native Code compilava pra assembly real, era mais rapido
' mas gerava .exe maior e as vezes com bugs diferentes

OptimizationType=0
FavorPentiumPro(tm)=0   ' sim, tinha opcao pra otimizar pro Pentium Pro
' Era 1998. Pentium Pro era top de linha.
CodeViewDebugInfo=0
StartMode=0
Unattended=0
Retained=0
ThreadPerObject=0
MaxNumberOfThreads=1
DebugStartupOption=0
