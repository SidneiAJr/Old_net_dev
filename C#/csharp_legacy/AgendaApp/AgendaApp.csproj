                />
            </Settings>

            <!-- Referencias do projeto -->
            <References>
                <!-- System.dll - classes basicas do .NET -->
                <Reference
                    Name = "System"
                    AssemblyName = "System"
                    HintPath = "..\..\..\..\WINDOWS\Microsoft.NET\Framework\v1.1.4322\System.dll"
                />
                <!-- System.Data.dll - ADO.NET, DataSet, DataTable -->
                <Reference
                    Name = "System.Data"
                    AssemblyName = "System.Data"
                    HintPath = "..\..\..\..\WINDOWS\Microsoft.NET\Framework\v1.1.4322\System.Data.dll"
                />
                <!-- System.Drawing.dll - Point, Size, Color, etc -->
                <Reference
                    Name = "System.Drawing"
                    AssemblyName = "System.Drawing"
                    HintPath = "..\..\..\..\WINDOWS\Microsoft.NET\Framework\v1.1.4322\System.Drawing.dll"
                />
                <!-- System.Windows.Forms.dll - Windows Forms -->
                <Reference
                    Name = "System.Windows.Forms"
                    AssemblyName = "System.Windows.Forms"
                    HintPath = "..\..\..\..\WINDOWS\Microsoft.NET\Framework\v1.1.4322\System.Windows.Forms.dll"
                />
                <!-- System.XML.dll - XML, XmlDocument, etc -->
                <Reference
                    Name = "System.XML"
                    AssemblyName = "System.Xml"
