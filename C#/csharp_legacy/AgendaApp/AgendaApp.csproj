<?xml version="1.0" encoding="utf-8"?>
<!--
    AgendaApp.csproj
    Arquivo de projeto do Visual Studio 2003 / .NET 1.1
    
    Era um XML GIGANTE comparado com o .csproj moderno.
    O .NET SDK-style project (2017+) ficou assim:
    
        <Project Sdk="Microsoft.NET.Sdk">
          <PropertyGroup>
            <OutputType>WinExe</OutputType>
            <TargetFramework>net8.0-windows</TargetFramework>
          </PropertyGroup>
        </Project>
    
    Em 2003 era o monstro XML abaixo. O Visual Studio gerava,
    o programador nao tocava. Se editasse na mao, coragem.
-->
<VisualStudioProject>
    <CSHARP
        ProjectType = "Local"
        ProductVersion = "7.10.3077"
        SchemaVersion = "2.0"
        ProjectGuid = "{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}"
    >
        <Build>
            <Settings
                ApplicationIcon = ""
                AssemblyKeyContainerName = ""
                AssemblyName = "AgendaApp"
                AssemblyOriginatorKeyFile = ""
                DefaultClientScript = "JScript"
                DefaultHTMLPageLayout = "Grid"
                DefaultTargetSchema = "IE50"
                DelaySign = "false"
                OutputType = "WinExe"
                PreBuildEvent = ""
                PostBuildEvent = ""
                RootNamespace = "AgendaApp"
                RunPostBuildEvent = "OnBuildSuccess"
                StartupObject = "AgendaApp.Program"
            >
                <!-- Debug config -->
                <Config
                    Name = "Debug"
                    AllowUnsafeBlocks = "false"
                    BaseAddress = "285212672"
                    CheckForOverflowUnderflow = "false"
                    ConfigurationOverrideFile = ""
                    DefineConstants = "DEBUG;TRACE"
                    DocumentationFile = ""
                    DebugSymbols = "true"
